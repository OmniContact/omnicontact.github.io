<mujoco model="carrybox scene">
    <!-- 1. 原有机器人（索引 0 到 35 左右） -->
    <include file="g1_29dof_rev_1_0_new.xml"/>

    <statistic center="1.0 0.7 1.0" extent="0.8"/>

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="-140" elevation="-20"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
        <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="0.4 0.02 0.001"/>
        
        <!-- 2. 箱子（接在机器人索引之后） -->
        <body name="box" pos="1 0 0.26" quat="1 0 0 0">  
            <freejoint name="box"/> 
            <inertial pos="0 0 0" mass="6" diaginertia="0.02 0.02 0.02"/>  
            <geom name="box_geom_bottom" type="box" pos="0 0 -0.21" size="0.23 0.25 0.05" rgba="0.8 0.6 0.4 1"
            friction="0.001 0.0005 0.0001" contype="4" conaffinity="3"/>
            <geom name="box_geom_top" type="box" pos="0 0 0.05" size="0.23 0.25 0.21" rgba="0.8 0.6 0.4 1"
            friction="0.5 0.02 0.001" contype="4" conaffinity="3"/>
        </body>  
        
        <body name="plane_1_holder" mocap="true" pos="1 1 0.6">
            <geom name="plane_1" type="box" size="0.12 0.12 0.01" rgba="0.7 0. 0. 1" pos="0 0 0" friction="1.0 0.02 0.001"
            contype="0" conaffinity="0"/>
        </body>
        <body name="plane_2_holder" mocap="true" pos="1 1 0.4">
            <geom name="plane_2" type="box" size="0.12 0.12 0.01" rgba="0. 0.7 0. 1" pos="0 0 0" friction="1.0 0.02 0.001"
            contype="0" conaffinity="0"/>
        </body>

        <!-- 3. 将 Ghost 放在 worldbody 的最后面 -->
        <include file="g1_ghost.xml"/>
        <body name="ghost_box" pos="0 0 0">  
            <freejoint name="ghost_box_joint"/> 
            <geom name="ghost_box_geom_bottom" type="box" pos="0 0 -0.21" size="0.23 0.25 0.05" rgba="0.9 0.3 0 0"
            contype="0" conaffinity="0" group="1"/>
            <geom name="ghost_box_geom_top" type="box" pos="0 0 0.05" size="0.23 0.25 0.21" rgba="0.9 0.3 0 0"
            contype="0" conaffinity="0" group="1"/>
        </body>
        

        <!-- Wrist reference visualization (mocap): rubber hand mesh -->
        <body name="ref_l_wrist_frame" pos="0 0 0" mocap="true">
            <geom name="ref_l_rubber_hand" type="mesh" mesh="left_rubber_hand" pos="0.0415 0.003 0" quat="1 0 0 0"
                  rgba="1 1 0 0.7" contype="0" conaffinity="0" group="1" density="0"/>
        </body>

        <body name="ref_r_wrist_frame" pos="0 0 0" mocap="true">
            <geom name="ref_r_rubber_hand" type="mesh" mesh="right_rubber_hand" pos="0.0415 -0.003 0" quat="1 0 0 0"
                  rgba="1 1 0 0.7" contype="0" conaffinity="0" group="1" density="0"/>
        </body>

        <!-- Torso + ankles reference visualization (mocap) -->
        <body name="ref_torso_frame" pos="0 0 0" mocap="true">
            <geom name="ref_torso_mesh" type="mesh" mesh="torso_link" rgba="1 1 0 0.7"
                  contype="0" conaffinity="0" group="1" density="0"/>
        </body>

        <body name="ref_l_ankle_frame" pos="0 0 0" mocap="true">
            <geom name="ref_l_ankle_mesh" type="mesh" mesh="right_ankle_roll_link" rgba="1 1 0 0.7"
                  contype="0" conaffinity="0" group="1" density="0"/>
        </body>

        <body name="ref_r_ankle_frame" pos="0 0 0" mocap="true">
            <geom name="ref_r_ankle_mesh" type="mesh" mesh="right_ankle_roll_link" rgba="1 1 0 0.7"
                  contype="0" conaffinity="0" group="1" density="0"/>
        </body>

    </worldbody>  
</mujoco>
